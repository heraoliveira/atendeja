# Copie este arquivo para .env no ambiente local.
# Use apenas placeholders seguros aqui. Nunca versionar secrets reais.

SPRING_PROFILES_ACTIVE=dev

# Banco local usado pelo Docker Compose.
POSTGRES_DB=atendeja
POSTGRES_USER=atendeja_user
POSTGRES_PASSWORD=change_me_local_password
POSTGRES_PORT=5432

# Banco usado quando o backend roda fora do Docker Compose.
# Em produção no Render, use uma URL JDBC para o PostgreSQL gerenciado.
DATABASE_URL=jdbc:postgresql://localhost:5432/atendeja
DATABASE_USERNAME=atendeja_user
DATABASE_PASSWORD=change_me_local_password

API_PORT=8080
SERVER_PORT=8080
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api/v1

JWT_SECRET=change_this_local_demo_secret_with_at_least_32_characters
JWT_EXPIRATION=PT8H

DEMO_AUTH_USERS_ENABLED=true
DEMO_ADMIN_EMAIL=admin@atendeja.local
DEMO_ADMIN_PASSWORD=change_me_admin_local
DEMO_ATTENDANT_EMAIL=attendant@atendeja.local
DEMO_ATTENDANT_PASSWORD=change_me_attendant_local

CORS_ALLOWED_ORIGINS=http://localhost:5173
